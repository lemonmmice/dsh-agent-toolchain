node_modules/
*.log
results/results-*.json
.DS_Store
# Benchmark: task packages, run artifacts and local agent-env overrides are
# local-only (privacy + answer secrecy). See bench/README.md.
bench/tasks/
bench-runs/
bench/local.env
# Sample app build output. obj/ holds NuGet-generated paths (machine-specific
# text) — without this the repo gate would have to scan them as committable.
samples/**/bin/
samples/**/obj/
# Tool evidence dirs (screenshots, UI text, build logs) are local-only.
.dsh-agent-toolchain/
.dsh-ui-evidence/
# Tool last-run pointers written next to the caller's cwd when a tool runs
# from the repo root (build/perf/verify).
last-probe.json
last.json
# Rust build cache stays outside the deployable plugin; only staged executables ship.
/native/windows-process-table/target/
/plugins/dsh-win-terminal-inspector/bin/
/native/capture-store/target/
/plugins/dsh-api-visualizer/bin/
/native/memory-store/target/
/plugins/dsh-memory/bin/
/native/trace-fold/target/
/plugins/dsh-perf/bin/
