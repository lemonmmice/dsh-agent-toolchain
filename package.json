{
  "name": "dsh-agent-toolchain",
  "description": "Agent-visible engineering quality loop for desktop client development — a suite of DeepSeek Harness web-GUI plugins (build / ui-drive / api-visualizer / postman / perf / hang-inspector / memory / terminal inspector).",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build:trace-fold": "node scripts/build-trace-fold.mjs",
    "test:trace-native": "cargo test --locked --no-default-features --manifest-path native/trace-fold/Cargo.toml --target-dir .dsh-agent-toolchain/native",
    "bench:trace-fold": "node scripts/bench-trace-fold.mjs",
    "build:memory-store": "node scripts/build-memory-store.mjs",
    "test:memory-native": "cargo test --locked --no-default-features --manifest-path native/memory-store/Cargo.toml --target-dir .dsh-agent-toolchain/native",
    "bench:memory-store": "node scripts/bench-memory-store.mjs",
    "build:capture-store": "node scripts/build-capture-store.mjs",
    "test:capture-native": "cargo test --locked --no-default-features --manifest-path native/capture-store/Cargo.toml --target-dir .dsh-agent-toolchain/native",
    "bench:capture-store": "node scripts/bench-capture-store.mjs",
    "build:terminal-inspector": "node scripts/build-terminal-inspector.mjs",
    "test:terminal-native": "cargo test --locked --manifest-path native/windows-process-table/Cargo.toml --target-dir .dsh-agent-toolchain/native",
    "bench:terminal-inspector": "node plugins/dsh-win-terminal-inspector/test/bench-process-table.mjs",
    "bench:mcp": "node scripts/bench-mcp.mjs",
    "bench:jev": "node scripts/bench-jev.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:json": "node scripts/run-tests.mjs --json",
    "native-stacks": "node lib/native-stacks.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/plugin-load-smoke.mjs",
    "smoke:json": "node scripts/plugin-load-smoke.mjs --json",
    "verify": "node scripts/run-tests.mjs && node scripts/check.mjs && node scripts/plugin-load-smoke.mjs && node mcp/smoke.mjs",
    "bench": "node bench/harness/bench.mjs"
  },
  "repository": {
    "url": "https://github.com/lemonmmice/dsh-agent-toolchain.git",
    "type": "git"
  }
}
