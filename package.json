{
  "name": "dsh-agent-toolchain",
  "description": "Agent-visible engineering quality loop for desktop client development — a suite of DeepSeek Harness web-GUI plugins (build / ui-drive / api-visualizer / postman / perf / hang-inspector / memory / terminal inspector).",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:trace-fold": "node scripts/build-trace-fold.mjs",
    "build:perf-analysis": "node scripts/build-perf-analysis.mjs",
    "build:memory-store": "node scripts/build-memory-store.mjs",
    "bench:memory-store": "node scripts/bench-memory-store.mjs",
    "build:capture-store": "node scripts/build-capture-store.mjs",
    "bench:capture-store": "node scripts/bench-capture-store.mjs",
    "build:terminal-inspector": "node scripts/build-terminal-inspector.mjs",
    "bench:mcp": "node scripts/bench-mcp.mjs",
    "bench:jev": "node scripts/bench-jev.mjs",
    "demo": "node mcp/demo/run-demo.mjs",
    "demo:perf": "node mcp/demo/run-demo.mjs --with-perf",
    "demo:build": "dotnet build samples/DemoClient/DemoClient.csproj -c Release",
    "native-stacks": "node lib/native-stacks.mjs",
    "check": "node scripts/check.mjs",
    "bench": "node bench/harness/bench.mjs"
  },
  "repository": {
    "url": "https://github.com/lemonmmice/dsh-agent-toolchain.git",
    "type": "git"
  }
}
